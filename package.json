{
  "name": "cs-visual-test",
  "version": "1.0.0",
  "description": "Scratch-style visual C# IDE prototype with live code/block synchronization.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:api": "dotnet run --project server/CsVisualTest.Roslyn/CsVisualTest.Roslyn.csproj --urls http://localhost:5087",
    "build": "tsc --noEmit && vite build",
    "build:api": "dotnet build CSVisualTest.sln --no-restore",
    "build:all": "npm run build && npm run build:api",
    "test": "vitest run",
    "test:api": "dotnet test CSVisualTest.sln --no-build",
    "test:all": "npm run test && npm run test:api",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulild/CSVisualTest.git"
  },
  "keywords": [
    "csharp",
    "visual-programming",
    "scratch",
    "ide"
  ],
  "author": "Cursor Agent",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vulild/CSVisualTest/issues"
  },
  "homepage": "https://github.com/vulild/CSVisualTest#readme",
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
